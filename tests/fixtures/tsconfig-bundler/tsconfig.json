{
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "customConditions": ["source"],
    "target": "esnext",
    "strict": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "baseUrl": ".",
    "paths": {
      "external-pkg": ["./pkg/external/types.ts"]
    }
  }
}
