{
  "name": "@tsoa/compiler-helper-tsgo",
  "version": "0.1.0",
  "description": "Lets tsoa take type information from tsgo, the Go compiler from microsoft/TypeScript",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lukeautry/tsoa.git",
    "directory": "packages/cli-native/npm/compiler-helper-tsgo"
  },
  "main": "index.js",
  "files": [
    "index.js"
  ],
  "tsoaCompilerHelper": {
    "compiler": "tsgo",
    "typescriptVersion": "7.1.0-beta",
    "upstream": {
      "repository": "https://github.com/microsoft/TypeScript",
      "ref": "7.1.0-beta",
      "revision": "3e9236361fa97a9e6c685f4833ac457ae2d8c50a"
    },
    "protocol": 8
  },
  "optionalDependencies": {
    "@tsoa/compiler-helper-tsgo-darwin-arm64": "0.1.0",
    "@tsoa/compiler-helper-tsgo-darwin-x64": "0.1.0",
    "@tsoa/compiler-helper-tsgo-linux-arm64": "0.1.0",
    "@tsoa/compiler-helper-tsgo-linux-x64": "0.1.0",
    "@tsoa/compiler-helper-tsgo-win32-x64": "0.1.0"
  }
}
